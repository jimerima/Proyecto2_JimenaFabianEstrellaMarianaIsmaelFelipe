            <Table Name="HistoricoTickets_TecDigital.csv" Left="1955" Top="947" Width="993" Height="585" IsMinimized="false" ActiveActionIndex="15" ViewMode="Table">
              <Actions>
                <ImportDelimitedTextAction DecimalSeparator="Comma" ThousandSeparator="Point" ShowParsingErrors="false" IgnoreQuoting="false" NumericValuesTreatmentOption="AlwaysAsNumbers" ColumnsDontHaveHeaders="false" LoadAllColumns="true" AddColumnsWhenRowsHaveMoreValuesThanHeaders="false">
                  <MetaColumns>
                    <MetaColumn OriginalName="Agente_x0020_de_x0020_soporte" Width="107" />
                    <MetaColumn OriginalName="Asunto" Width="120" />
                    <MetaColumn OriginalName="Canal" Width="41" />
                    <MetaColumn OriginalName="Estado" Width="51" />
                    <MetaColumn OriginalName="ID" Width="36" />
                    <MetaColumn OriginalName="Prioridad" Width="58" />
                    <MetaColumn OriginalName="Resuelto" Width="127" Format="DateDDMMMYYYYHMMSSAMPM" FormatOrigin="Autodetected" />
                    <MetaColumn OriginalName="Rol_x0020_de_x0020_usuario" Width="134" />
                    <MetaColumn OriginalName="Servicio_x0020_relacionado" Width="265" />
                    <MetaColumn OriginalName="Solicitado" Width="127" Format="DateDDMMMYYYYHMMSSAMPM" FormatOrigin="Autodetected" />
                    <MetaColumn OriginalName="Tipo" Width="51" />
                  </MetaColumns>
                  <InputFileDefinition Mode="Single">
                    <FileName Value="C:\Users\felip\Downloads\HistoricoTickets_TecDigital.csv" Type="Path" />
                  </InputFileDefinition>
                  <SkipLines Value="0" Type="Number" />
                  <MaxLines Value="0" Type="Number" />
                  <Separator SeparatorType="Semicolon" />
                  <Encoding EncodingType="ANSI" />
                </ImportDelimitedTextAction>
                <AddColumnsAction ColumnExistsOption="Rename">
                  <Columns>
                    <NameExpressionPair Name="fecha_solicitud_lookup">
                      <Expression Value="format([Solicitado], 'dd-MMM-yyyy')" Type="Expression" />
                    </NameExpressionPair>
                    <NameExpressionPair Name="fecha_resuelto_lookup">
                      <Expression Value="format([Resuelto], 'dd-MMM-yyyy')" Type="Expression" />
                    </NameExpressionPair>
                  </Columns>
                  <InsertPosition Position="Rightmost" />
                </AddColumnsAction>
                <ReplaceColumnsAction>
                  <Columns>
                    <NameExpressionPair Name="Prioridad">
                      <Expression Value="if(isempty([Prioridad]) or [Prioridad] = &quot;'-&quot;, 'No especificado', [Prioridad])" Type="Expression" />
                    </NameExpressionPair>
                    <NameExpressionPair Name="Servicio relacionado">
                      <Expression Value="if(isempty([Servicio relacionado]), 'No especificado', [Servicio relacionado])" Type="Expression" />
                    </NameExpressionPair>
                    <NameExpressionPair Name="Canal">
                      <Expression Value="if(isempty([Canal]), 'No especificado', [Canal])" Type="Expression" />
                    </NameExpressionPair>
                    <NameExpressionPair Name="Tipo">
                      <Expression Value="if(isempty([Tipo]), 'No especificado', [Tipo])" Type="Expression" />
                    </NameExpressionPair>
                    <NameExpressionPair Name="Estado">
                      <Expression Value="if(isempty([Estado]), 'No especificado', [Estado])" Type="Expression" />
                    </NameExpressionPair>
                    <NameExpressionPair Name="Rol de usuario">
                      <Expression Value="if(isempty([Rol de usuario]), 'No especificado', [Rol de usuario])" Type="Expression" />
                    </NameExpressionPair>
                    <NameExpressionPair Name="Agente de soporte">
                      <Expression Value="if(isempty([Agente de soporte]), 'No especificado', [Agente de soporte])" Type="Expression" />
                    </NameExpressionPair>
                  </Columns>
                </ReplaceColumnsAction>
                <LookupAction LookupTableName="dim_tiempo.csv" SecondTableExists="true" ColumnName="fecha_solicitud_lookup" LookupColumnName="Fecha_completa" ReturnColumnName="RowNo" CreateNewColumn="false" ValueNotFoundOption="MakeEmpty" />
                <LookupAction LookupTableName="dim_tiempo.csv" SecondTableExists="true" ColumnName="fecha_resuelto_lookup" LookupColumnName="Fecha_completa" ReturnColumnName="RowNo" CreateNewColumn="false" ValueNotFoundOption="MakeEmpty" />
                <LookupAction LookupTableName="dim_agente.csv" SecondTableExists="true" ColumnName="Agente de soporte" LookupColumnName="nombre_agente" ReturnColumnName="id_agente" CreateNewColumn="false" ValueNotFoundOption="MakeEmpty" />
                <LookupAction LookupTableName="dim_servicio.csv" SecondTableExists="true" ColumnName="Servicio relacionado" LookupColumnName="nombre_servicio" ReturnColumnName="id_servicio" CreateNewColumn="false" ValueNotFoundOption="MakeEmpty" />
                <LookupAction LookupTableName="dim_canal.csv" SecondTableExists="true" ColumnName="Canal" LookupColumnName="nombre_canal" ReturnColumnName="id_canal" CreateNewColumn="false" ValueNotFoundOption="MakeEmpty" />
                <LookupAction LookupTableName="dim_tipo.csv" SecondTableExists="true" ColumnName="Tipo" LookupColumnName="nombre_tipo" ReturnColumnName="id_tipo" CreateNewColumn="false" ValueNotFoundOption="MakeEmpty" />
                <LookupAction LookupTableName="dim_prioridad.csv" SecondTableExists="true" ColumnName="Prioridad" LookupColumnName="nombre_prioridad" ReturnColumnName="id_prioridad" CreateNewColumn="false" ValueNotFoundOption="MakeEmpty" />
                <LookupAction LookupTableName="dim_usuario.csv" SecondTableExists="true" ColumnName="Rol de usuario" LookupColumnName="nombre_usuario" ReturnColumnName="id_usuario" CreateNewColumn="false" ValueNotFoundOption="MakeEmpty" />
                <LookupAction LookupTableName="dim_estado.csv" SecondTableExists="true" ColumnName="Estado" LookupColumnName="nombre_estado" ReturnColumnName="id_estado" CreateNewColumn="false" ValueNotFoundOption="MakeEmpty" />
                <AddColumnsAction ColumnExistsOption="Rename">
                  <MetaColumns>
                    <MetaColumn OriginalName="tiempo_resolucion_horas" Width="140" />
                  </MetaColumns>
                  <Columns>
                    <NameExpressionPair Name="tiempo_resolucion_horas">
                      <Expression Value="if(isempty([Resuelto]), empty(), round(([Resuelto] - [Solicitado]) * 24, 2))" Type="Expression" />
                    </NameExpressionPair>
                  </Columns>
                  <InsertPosition Position="Rightmost" />
                </AddColumnsAction>
                <AddColumnsAction ColumnExistsOption="Rename">
                  <MetaColumns>
                    <MetaColumn OriginalName="cumple_sla" Width="67" />
                  </MetaColumns>
                  <Columns>
                    <NameExpressionPair Name="cumple_sla">
                      <Expression Value="if(isempty([tiempo_resolucion_horas]), empty(), if([tiempo_resolucion_horas] &lt;= 4, 1, 0))" Type="Expression" />
                    </NameExpressionPair>
                  </Columns>
                  <InsertPosition Position="Rightmost" />
                </AddColumnsAction>
                <RenameColumnsAction>
                  <Names>
                    <NamePair Name1="Estado" Name2="id_dim_estado" />
                    <NamePair Name1="Rol de usuario" Name2="id_dim_usuario" />
                    <NamePair Name1="Agente de soporte" Name2="id_dim_agente" />
                    <NamePair Name1="Servicio relacionado" Name2="id_dim_servicio" />
                    <NamePair Name1="Canal" Name2="id_dim_canal" />
                    <NamePair Name1="Tipo" Name2="id_dim_tipo" />
                    <NamePair Name1="Prioridad" Name2="id_dim_prioridad" />
                    <NamePair Name1="fecha_solicitud_lookup" Name2="id_dim_tiempo_solicitud" />
                    <NamePair Name1="fecha_resuelto_lookup" Name2="id_dim_tiempo_resuelto" />
                  </Names>
                </RenameColumnsAction>
                <KeepRemoveColumnsAction Mode="Remove" FailIfColumnsNotFound="false">
                  <ColumnNames>
                    <Item>Solicitado</Item>
                    <Item>Resuelto</Item>
                  </ColumnNames>
                </KeepRemoveColumnsAction>
                <ExportDelimitedTextAction AutoStatus="true" DecimalSeparator="Point" WrapTextMode="Auto" DontWriteColumnHeaders="false" PreserveFormatting="true" ExportFileMode="Create" DontWriteBom="false" FileExistsOption="HaltProjectExecution">
